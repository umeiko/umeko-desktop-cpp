#include <windows.h>

IDI_ICON1 ICON "icons/app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION UMEKO_VERSION_RC
 PRODUCTVERSION UMEKO_VERSION_RC
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Umeko-Desktop\0"
            VALUE "FileVersion", UMEKO_VERSION "\0"
            VALUE "ProductName", "Umeko-Desktop\0"
            VALUE "ProductVersion", UMEKO_VERSION "\0"
            VALUE "OriginalFilename", "UmekoCpp.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
